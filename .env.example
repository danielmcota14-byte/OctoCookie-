# OctoCookie — variáveis de ambiente (Vercel → Settings → Environment Variables)
# NÃO commite chaves reais.

# Até 5 chaves Groq (https://console.groq.com), separadas por vírgula:
GROQ_API_KEYS=gsk_chave1,gsk_chave2,gsk_chave3,gsk_chave4,gsk_chave5

# Opcional: forçar um modelo (padrão: openai/gpt-oss-120b com fallback)
# GROQ_MODEL=qwen/qwen3.8-27b
