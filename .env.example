# OctoCookie — copie para .env local ou configure no Vercel
# Project → Settings → Environment Variables
# NUNCA faça commit de chaves reais.

# Até 5 chaves Groq (https://console.groq.com), separadas por vírgula:
GROQ_API_KEYS=

# Opcional: forçar modelo (padrão tenta openai/gpt-oss-120b → qwen → gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b

# ---------- Bot 24/7 (bot-server/) — configure no serviço do Render, NÃO no site ----------
# OWNER_TOKEN=            # mín. 24 caracteres; o site pede esse token no card "Bot 24/7 no servidor"
# SERVER_MASTER_KEY=      # opcional: openssl rand -base64 32 (só para "reiniciar sozinho")
# RPC_URL_ETHEREUM=       # RPC https seu (Alchemy/Infura)
