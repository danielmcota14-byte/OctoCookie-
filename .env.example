# OctoCookie — variáveis de ambiente
# No Vercel: Project → Settings → Environment Variables
# Adicione GROQ_API_KEY para Production, Preview e Development.
# NÃO commite o arquivo .env com a chave real.

# Chave da API Groq (servidor apenas — nunca VITE_*)
# Obtenha em https://console.groq.com
GROQ_API_KEY=

# Opcional: outras chaves do app público (MoonPay etc.)
# MOONPAY_PUBLIC_KEY=
# MOONPAY_SECRET_KEY=
