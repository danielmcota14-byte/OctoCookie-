# ══════════════════════════════════════════════════════
#  OCTOCOOKIE — Variáveis de Ambiente
#  Copie este arquivo como .env na raiz do projeto
#  OU adicione cada variável em:
#    Netlify → Site configuration → Environment variables
# ══════════════════════════════════════════════════════

# MoonPay — chave pública (usada no widget de compra)
MOONPAY_PUBLIC_KEY=pk_test_RvIA92DwVnZKEHmVVQ3nmkZuHwLn1ImT

# MoonPay — chave secreta (NÃO expor no frontend)
MOONPAY_SECRET_KEY=sk_test_2NHAV2nC7zRxdOE0N8FbDyhrNlA2Nb

# MoonPay — chave de verificação de webhook
MOONPAY_WEBHOOK_KEY=wk_test_oiV3MYedURlJ24cC3gJEG3FUyvNVx

# URL do widget MoonPay (sandbox ou produção)
# Sandbox:  https://buy-sandbox.moonpay.com
# Produção: https://buy.moonpay.com
MOONPAY_WIDGET_URL=https://buy-sandbox.moonpay.com

# ── Mercado Pago ──────────────────────────────────────
# Usadas pela Netlify Function em netlify/functions/verificar-pagamento.js
# para confirmar, no backend, se um CPF tem um pagamento aprovado.

# Chave pública — pode ser usada no frontend (ex: inicializar o Checkout)
MP_PUBLIC_KEY=TEST-2775618526021736-080119-50cef226f18415c1723746dbe1aac521-1418361885

# Access Token — NUNCA expor no frontend/bundle. Só é lido dentro da
# Netlify Function, em process.env.MP_ACCESS_TOKEN.
MP_ACCESS_TOKEN=TEST-bffc9618-9608-495f-a470-83925e8ff200

# Ao ir para produção, troque as duas acima pelas credenciais reais
# (Access Token e Public Key de produção) da conta Mercado Pago,
# mantendo o mesmo padrão de variável de ambiente.
