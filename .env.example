# OctoCookie — copie para .env (local) ou configure no painel do Render. NUNCA faça commit de chaves reais.

# Até 5 chaves Groq (https://console.groq.com), separadas por vírgula. Serve: chat, Finance, Start, Analisador, Simulador, IDE.
GROQ_API_KEYS=
# 1 chave Groq para a "Cookie Potencializada" do CookieScript (pode ser uma das de cima)
GROQ_API_KEY=

# ---------- Bot 24/7 ----------
# OWNER_TOKEN=        # mín. 24 caracteres. Se vazio, usa o token de public/octocookie-app/bot-config.js
# SERVER_MASTER_KEY=  # opcional: openssl rand -base64 32
# RPC_URL_ETHEREUM=   # RPC https (Alchemy/Infura)
# ADMIN_UIDS= / ADMIN_EMAILS= / ADSTERRA_TOKEN=

# (Não precisa configurar URL do bot nem do CookieScript: tudo roda na mesma origem — /bot e /cookiescript-app.)

# ---------- Token OctoCookie (todas só no SERVIDOR; nada disso vai para o navegador) ----------
# TOKEN_CONTRACT_ADDRESS=0x2f5f737D15ec5C79995f2d72dD0A0DaA1b75a44D  # OctoToken (Sepolia). Já é o padrão; o servidor confere código e ABI na rede antes de habilitar qualquer coisa
# TOKEN_CHAIN_ID=11155111   # Sepolia (padrão)
# TOKEN_RPC_URL=            # OPCIONAL (padrão: RPC público da Sepolia). RPC https dessa rede
# TOKEN_TREASURY_ADDRESS=   # OPCIONAL (padrão: owner() do contrato). Carteira que recebe os pagamentos por transfer()
# TOKEN_EXPLORER_URL=https://sepolia.etherscan.io   # padrão
# TOKEN_MIN_CONFIRMATIONS=3 # confirmações exigidas antes de liberar uma compra
# TOKEN_ORDER_TTL_MIN=30    # validade de um pedido, em minutos
# TOKEN_HISTORY_BLOCKS=5000 # janela do histórico on-chain
# TOKEN_SKIP_SELECTOR_CHECK=1  # só para contratos proxy
# TOKEN_MINTER_PRIVATE_KEY= # OPCIONAL e SENSÍVEL: só se quiser emitir recompensas pelo servidor. Deve ser o owner() do contrato.
#                           # O recomendado é deixar vazio e emitir/registrar manualmente (aba Admin > Registrar emissão manual).
